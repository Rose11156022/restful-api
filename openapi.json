    "/api/v1/stations/nearby": {
      "get": {
        "tags": [
          "YouBike 場站管理 (Stations CRUD)"
        ],
        "summary": "經緯度周邊場站查詢 (Nearby)",
        "description": "給定經緯度座標與半徑 (公尺)，計算並回傳周邊最近的 YouBike 場站資訊與直線距離。",
        "operationId": "get_nearby_stations_api_v1_stations_nearby_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "中心點緯度 (例: 25.02605)",
              "title": "Latitude"
            },
            "description": "中心點緯度 (例: 25.02605)"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "中心點經度 (例: 121.54360)",
              "title": "Longitude"
            },
            "description": "中心點經度 (例: 121.54360)"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 10000.0,
              "minimum": 50.0,
              "description": "搜尋半徑 (公尺，預設 1000m)",
              "default": 1000.0,
              "title": "Radius"
            },
            "description": "搜尋半徑 (公尺，預設 1000m)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "最多回傳筆數 (預設 10)",
              "default": 10,
              "title": "Limit"
            },
            "description": "最多回傳筆數 (預設 10)"
          }
