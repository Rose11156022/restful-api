            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(asc|desc)$",
              "description": "排序方向 (asc: 遞增, desc: 遞減)",
              "default": "asc",
              "title": "Order"
            },
            "description": "排序方向 (asc: 遞增, desc: 遞減)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
