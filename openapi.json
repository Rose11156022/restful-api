        "description": "查詢 YouBike 2.0 場站清單，支援分頁、關鍵字搜尋（站名/地址/編號）、行政區過濾、營運狀態及最小可借車輛數篩選。",
        "operationId": "list_stations_api_v1_stations_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "頁碼 (從 1 開始)",
              "default": 1,
              "title": "Page"
            },
            "description": "頁碼 (從 1 開始)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "每頁筆數 (預設 20，上限 100)",
              "default": 20,
              "title": "Page Size"
            },
            "description": "每頁筆數 (預設 20，上限 100)"
          },
          {
            "name": "district",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "行政區名稱過濾 (例: 大安區, 信義區)",
              "title": "District"
            },
            "description": "行政區名稱過濾 (例: 大安區, 信義區)"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "關鍵字搜尋 (模糊搜尋站名、地址或代號)",
              "title": "Keyword"
            },
            "description": "關鍵字搜尋 (模糊搜尋站名、地址或代號)"
          },
          {
            "name": "act",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[01]$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "營運狀態 ('1': 營運中, '0': 暫停營運)",
              "title": "Act"
            },
            "description": "營運狀態 ('1': 營運中, '0': 暫停營運)"
          },
          {
            "name": "min_available",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "篩選至少有多少輛可借單車",
              "title": "Min Available"
            },
            "description": "篩選至少有多少輛可借單車"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(id|sno|total_slots|available_rent_bikes|available_return_bikes)$",
              "description": "排序欄位",
              "default": "id",
              "title": "Sort By"
            },
            "description": "排序欄位"
          },
          {
            "name": "order",
